{
  "domain": "buildings",
  "version": 1,
  "status": "draft_standards",
  "note": "Human-scale building standards for Dawn. Map root scale for hongkong_city stays K=1 (effective ×21.3967 door-fit). Do NOT uniformly scale all buildings. AI/authors must pass autocheck before marking live.",
  "map_root_policy": {
    "hongkong_city": {
      "extra_uniform_mul_K": 1.0,
      "effective_model_scale": 10.6983,
      "fit_by_door_height": true,
      "fit_by_span": false,
      "pedestrian_door_anchor_m": 2.1,
      "note": "Door-fit restored (epoch 4) on 2026-11-06 GLB: raw door≈0.196m → root ≈×10.6983, door≈2.1m, span≈1.4km. Coord migrate e3→e4 still ×21.3967 (legacy e2 frame). No realism-span stack.",
      "forbid_global_remap": true,
      "forbid_blend_glb_edit": true
    }
  },
  "player_reference": {
    "height_m": 1.85,
    "forbid_shrink_player_to_hide_scale_bugs": true,
    "forbid_speed_change_to_hide_scale_bugs": true
  },
  "repair_policy": {
    "forbid_uniform_scale_all_buildings": true,
    "forbid_whole_building_uniform_scale_if_it_stretches_door_window_entrance_or_ground_floor": true,
    "prefer": [
      "floor_module_stack",
      "roof_and_upper_shell_extension",
      "cut_plane_vertical_extend_above_locked_ground_band",
      "godot_overlay_proxy_with_stable_id"
    ],
    "must_preserve": [
      "ground_footprint_anchor",
      "door_and_entrance_world_band",
      "collision_enterables",
      "stable_id",
      "adjacent_road_relationship"
    ],
    "priority_order": [
      "skyline_highrise",
      "garage_vehicle_clearance",
      "residential",
      "commercial",
      "industrial"
    ]
  },
