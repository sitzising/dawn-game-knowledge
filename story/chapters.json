    {
      "id": "ch_finale",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter",
        "finale"
      ],
      "data": {
        "title": "黎明选择",
        "order": 8,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 67,
        "locations": [
          "signal_tower_perimeter",
          "dock_warehouse_band",
          "chenghai_lab_ruin"
        ],
        "background": "所有伏笔结算。结局由累计 flags 与存活者决定，而非单次弹窗。",
        "why_enter": "灰潮后窗口；必须对广播/船/真相作出不可逆行动。",
        "goal": "写入 ending_id。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "终局方案可用性检定（见 endings.json）"
          },
          {
            "step": 2,
            "desc": "执行断塔 / 夺船 / 公开 / 交易之一"
          },
          {
            "step": 3,
            "desc": "结算 NPC 与世界状态"
          },
