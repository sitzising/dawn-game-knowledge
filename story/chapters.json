    {
      "id": "ch_05_remnant",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter"
      ],
      "data": {
        "title": "残令",
        "order": 5,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 58,
        "locations": [
          "dock_warehouse_band"
        ],
        "background": "关博用纪律维持仓库。弃城采样令在铁柜里。公开它会撕裂残部，也可能撕开澄海的合法外衣。",
        "why_enter": "需要官方文件证明广播与封城同源罪恶。",
        "goal": "取得或确认 abandon_order_known。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "用物流工牌或周晚晴引荐进入外围"
          },
          {
            "step": 2,
            "desc": "谈判或潜入铁柜"
          },
          {
            "step": 3,
            "desc": "阅读弃城采样附件"
          },
          {
            "step": 4,
            "desc": "选择逼关博公开或先保密带走副本"
          }
        ],
        "dialogues": [
          {
            "id": "dlg_rm_guan",
            "speaker": "npc_story_guan_bo",
            "lines": [
              "這裡還有秩序。你要是來搶糧，我開槍。",
              "……附件？你以為我沒看過？我看過。我還讓一百人睡得著。",
              "你公開它，明天倉庫可能先打起來，空殼後到。"
            ],
            "lines_en": [
              "There's still order here. Come for the grain and I shoot.",
              "…The attachment? You think I never read it? I did. And a hundred people still sleep at night because of that.",
              "You go public with it, and tomorrow the warehouse burns before the empty shells even arrive."
            ],
            "lines_zh_tw": [
              "這裡還有秩序。你要是來搶糧，我開槍。",
              "……附件？你以為我沒看過？我看過。我還讓一百人睡得著。",
              "你公開它，明天倉庫可能先打起來，空殼後到。"
            ],
            "emotion": "defensive",
            "speaker_name_en": "Guan Bo",
            "speaker_name_zh_tw": "關博"
          }
        ],
        "choices": [
          {
            "choice_id": "chc_rm_public",
            "prompt": "弃城令处理",
