    {
      "id": "ch_06_echo",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter"
      ],
      "data": {
        "title": "澄海回声",
        "order": 6,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 62,
        "locations": [
          "chenghai_lab_ruin"
        ],
        "background": "实验室废墟里，稳定剂真相与司衡本人等待对质。周晚晴可能同行。",
        "why_enter": "验证曦蚀规则与稳定剂；面对灰航线核心。",
        "goal": "获得 stabilizer_truth；与司衡首次正面对话。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "进入废墟，对抗护卫与实验体压力"
          },
          {
            "step": 2,
            "desc": "读取对照实验日志"
          },
          {
            "step": 3,
            "desc": "与司衡对峙"
          },
          {
            "step": 4,
            "desc": "决定杀、俘、或暂时撤离保留交易可能"
          }
        ],
        "dialogues": [
          {
            "id": "dlg_ec_log",
            "speaker": "实验日志",
            "lines": [
              "穩定劑：推遲語言崩解，不逆轉空殼。",
              "對照需求：未感染基線／鈍感攜帶者。",
              "廣播轉化率低於預期，提高「自願」話術。"
            ],
            "lines_en": [
              "Stabilizer: delays language collapse. Does not reverse empty-shell conversion.",
              "Controls needed: uninfected baseline / dulled carriers.",
              "Broadcast conversion below target. Increase voluntary language in scripts."
            ],
            "lines_zh_tw": [
              "穩定劑：推遲語言崩解，不逆轉空殼。",
              "對照需求：未感染基線／鈍感攜帶者。",
              "廣播轉化率低於預期，提高「自願」話術。"
            ],
            "emotion": "clinical",
            "speaker_name_en": "Lab Log",
            "speaker_name_zh_tw": "實驗日誌"
          },
          {
            "id": "dlg_ec_siheng",
            "speaker": "npc_story_siheng",
            "lines": [
              "你以為毀一台喇叭，城就會好？",
              "我在記帳。以後的人需要可重複的模型。你站在樣本這一側，還是記錄這一側？",
              "船是真的。名額不是為所有人準備的。這不是殘忍，是算術。"
            ],
            "lines_en": [
              "You think smashing one loudspeaker saves the city?",
              "I'm keeping the books. The next people need a repeatable model. Are you standing on the sample side — or the record side?",
              "The ship is real. The seats aren't for everyone. That isn't cruelty. It's arithmetic."
            ],
            "lines_zh_tw": [
              "你以為毀一台喇叭，城就會好？",
              "我在記帳。以後的人需要可重複的模型。你站在樣本這一側，還是記錄這一側？",
              "船是真的。名額不是為所有人準備的。這不是殘忍，是算術。"
            ],
            "emotion": "cold",
            "speaker_name_en": "Siheng",
            "speaker_name_zh_tw": "司衡"
          },
          {
            "id": "dlg_ec_zhou",
            "speaker": "npc_story_zhou_wanqing",
            "condition": "zhou_present",
            "lines": [
              "算術把我簽過的單變成刀。",
              "沈渡，別只聽他。也別只聽恨。"
            ],
            "lines_en": [
              "His arithmetic turned every form I signed into a blade.",
              "Shen Du — don't only listen to him. Don't only listen to hate either."
            ],
            "lines_zh_tw": [
              "算術把我簽過的單變成刀。",
              "沈渡，別只聽他。也別只聽恨。"
            ],
            "emotion": "anguish",
            "speaker_name_en": "Zhou Wanqing",
            "speaker_name_zh_tw": "周晚晴"
          }
        ],
        "choices": [
          {
            "choice_id": "chc_ec_siheng",
            "prompt": "对司衡",
            "options": [
              {
                "id": "spare",
                "effects": {
                  "flags": {
                    "stabilizer_truth": true,
                    "siheng_spared": true
                  }
                }
              },
              {
                "id": "capture",
                "effects": {
                  "flags": {
                    "stabilizer_truth": true,
                    "siheng_captured": true
                  }
                }
              },
              {
                "id": "kill",
                "effects": {
                  "flags": {
                    "stabilizer_truth": true,
                    "siheng_killed_early": true
                  },
                  "npc_alive": {
                    "npc_story_siheng": false
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "dungeon_lab",
          "lore_confirm",
          "boss_pressure"
        ],
        "entry": {
          "flags_required": [
            "abandon_order_known"
          ]
        },
        "exit": {
          "flags_required": [
            "stabilizer_truth"
          ]
        },
        "next_chapter_trigger": {
          "chapter_id": "ch_07_tide",
