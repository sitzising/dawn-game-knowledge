      "data": {
        "title": "澄海回声",
        "order": 6,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 62,
        "locations": [
          "chenghai_lab_ruin"
        ],
        "background": "实验室废墟里，稳定剂真相与司衡本人等待对质。周晚晴可能同行。",
        "why_enter": "验证曦蚀规则与稳定剂；面对灰航线核心。",
        "goal": "获得 stabilizer_truth；与司衡首次正面对话。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "进入废墟，对抗护卫与实验体压力"
          },
          {
            "step": 2,
            "desc": "读取对照实验日志"
          },
          {
            "step": 3,
            "desc": "与司衡对峙"
          },
          {
            "step": 4,
            "desc": "决定杀、俘、或暂时撤离保留交易可能"
          }
        ],
        "dialogues": [
          {
            "id": "dlg_ec_log",
            "speaker": "实验日志",
            "lines": [
              "稳定剂：推迟语言崩解，不逆转空壳。",
              "对照需求：未感染基线 / 钝感携带者。",
              "广播转化率低于预期，提高「自愿」话术。"
            ]
          },
          {
            "id": "dlg_ec_siheng",
            "speaker": "npc_story_siheng",
            "lines": [
              "你以为毁一台喇叭，城就会好？",
              "我在记账。以后的人需要可重复的模型。你站在样本这一侧，还是记录这一侧？",
              "船是真的。名额不是为所有人准备的。这不是残忍，是算术。"
            ]
          },
          {
            "id": "dlg_ec_zhou",
            "speaker": "npc_story_zhou_wanqing",
            "condition": "zhou_present",
            "lines": [
              "算术把我签过的单变成刀。",
              "沈渡，别只听他。也别只听恨。"
            ]
          }
        ],
        "choices": [
