      "data": {
        "title": "断路",
        "order": 4,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 55,
        "locations": [
          "cutroad_yard"
        ],
        "background": "无论名单如何处置，东环是通往码头与实验室的咽喉。根想做生意，铁眼想收血税。",
        "why_enter": "护送/载具线必须过卡，或绕行风险更高。",
        "goal": "达成 cutroad_dealt / cutroad_fought / cutroad_fled 之一，保护关键物资或人物通过。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "接触根谈判"
          },
          {
            "step": 2,
            "desc": "可选揭发根卖人（若已有线索）"
          },
          {
            "step": 3,
            "desc": "交易零件/弹药，或强攻，或弃货逃离"
          },
          {
            "step": 4,
            "desc": "铁眼可能介入"
          }
        ],
        "dialogues": [
          {
            "id": "dlg_cr_root",
            "speaker": "npc_story_root",
            "lines": [
              "過路費不收笑臉。收電池、收子彈，收你還用得上的東西。",
              "你要找船？那是喇叭的生意。我只賣路。"
            ],
            "lines_en": [
              "Toll doesn't take smiles. Batteries, bullets — anything you still need.",
              "Looking for a ship? That's loudspeaker business. I only sell the road."
            ],
            "lines_zh_tw": [
              "過路費不收笑臉。收電池、收子彈，收你還用得上的東西。",
              "你要找船？那是喇叭的生意。我只賣路。"
            ],
            "emotion": "mercenary",
            "speaker_name_en": "Root",
            "speaker_name_zh_tw": "根"
          },
          {
            "id": "dlg_cr_tieyan",
            "speaker": "npc_story_tieyan",
            "condition": "fight_or_betray",
            "lines": [
              "貨留下。人可以走。",
              "不走？"
            ],
            "lines_en": [
              "Leave the goods. You can walk.",
              "Not walking?"
            ],
            "lines_zh_tw": [
              "貨留下。人可以走。",
              "不走？"
            ],
            "emotion": "threatening",
            "speaker_name_en": "Tieyan",
