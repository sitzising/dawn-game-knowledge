    {
      "id": "ch_01_ember",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter",
        "playable_first"
      ],
      "data": {
        "title": "餘火",
        "order": 1,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 46,
        "locations": [
          "ember_outpost_near"
        ],
        "background": "广播让沈渡成为「可能的信徒」。何崖山需要劳动力，也需要证明外来者不会把据点坐标卖给喇叭。",
        "why_enter": "城门方向接触到餘火哨或被引导至旧中学。",
        "goal": "接触何崖山，取得餘火盟信任或明确拒绝其庇护，完成一次物资或护送。",
        "quest_flow": [
          {
            "step": 1,
            "id": "em_meet",
            "desc": "在据点外围通过搜身与问答"
          },
          {
            "step": 2,
            "id": "em_trial",
            "desc": "选择：护送伤员 / 取回被劫药箱"
          },
          {
            "step": 3,
            "id": "em_judge",
            "desc": "何崖山宣布信任或拒绝庇护"
          },
          {
            "step": 4,
            "id": "em_mai",
            "desc": "麦琴提供感染观察常识（可选）"
          }
        ],
        "major_events": [
          "初见餘火灶火",
          "「去者未归」墙",
          "信任检定"
        ],
        "dialogues": [
          {
            "id": "dlg_em_he_intro",
            "speaker": "npc_story_he_yashan",
            "lines": [
              "工牌還掛著。市政的人，鎖過多少門？",
              "這裡規矩簡單：先幹活，再吃飯。廣播的飯，我們不吃。",
              "你要留下，去把巷口那箱藥帶回來——或者把老陳護到白篷點。選一個。"
            ],
            "lines_en": [
              "Badge still on you. City hall man — how many doors did you lock?",
              "Rules here are simple: work first, then eat. We don't eat broadcast rations.",
              "If you're staying, bring the med crate from the alley — or get Old Chen to the white tent. Pick one."
            ],
            "lines_zh_tw": [
              "工牌還掛著。市政的人，鎖過多少門？",
              "這裡規矩簡單：先幹活，再吃飯。廣播的飯，我們不吃。",
              "你要留下，去把巷口那箱藥帶回來——或者把老陳護到白篷點。選一個。"
            ],
            "emotion": "suspicious",
            "speaker_name_en": "He Yashan",
            "speaker_name_zh_tw": "何崖山"
          },
          {
            "id": "dlg_em_mai",
            "speaker": "npc_story_mai_qin",
            "lines": [
              "發熱不等於空殼。別一槍崩了還能說話的人。",
              "深咬、清創、隔離。聽不懂就別碰傷員。"
            ],
            "lines_en": [
              "A fever isn't an empty shell. Don't put a round into someone who can still talk.",
              "Deep bites, clean wounds, isolate. If you don't get that, stay off the wounded."
            ],
            "lines_zh_tw": [
              "發熱不等於空殼。別一槍崩了還能說話的人。",
              "深咬、清創、隔離。聽不懂就別碰傷員。"
            ],
            "emotion": "stern",
            "speaker_name_en": "Mai Qin",
            "speaker_name_zh_tw": "麥琴"
          },
          {
            "id": "dlg_em_trust",
            "speaker": "npc_story_he_yashan",
            "condition": "trial_success",
            "lines": [
              "你沒把我們賣給喇叭。暫且算人。",
              "牆那邊的名字，別變成你的。"
            ],
            "lines_en": [
              "You didn't sell us to the loudspeakers. For now, you're people.",
              "Don't let your name end up on that wall."
            ],
            "lines_zh_tw": [
              "你沒把我們賣給喇叭。暫且算人。",
              "牆那邊的名字，別變成你的。"
            ],
            "emotion": "grudging",
            "speaker_name_en": "He Yashan",
            "speaker_name_zh_tw": "何崖山"
          }
        ],
        "choices": [
          {
            "choice_id": "chc_em_trial",
            "prompt": "信任试炼类型",
            "options": [
              {
                "id": "escort",
                "effects": {
                  "flags": {
                    "ember_trial_escort": true
                  }
                }
              },
              {
                "id": "supply",
                "effects": {
                  "flags": {
                    "ember_trial_supply": true
                  }
                }
              }
            ]
          },
          {
            "choice_id": "chc_em_join",
            "prompt": "是否接受餘火庇护",
            "options": [
              {
                "id": "accept",
                "effects": {
                  "flags": {
                    "ember_trusted": true
                  },
                  "faction": {
                    "faction_ember": 20
                  }
                }
              },
              {
                "id": "refuse",
                "effects": {
                  "flags": {
                    "ember_refused": true
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "meet_ally",
          "escort_or_supply",
          "trust_check"
        ],
        "environment_narrative": [
          "食堂黑板上的工分",
          "去者未归名单用炭笔写"
        ],
        "rewards": {
          "reputation_ember": "up_if_trusted",
          "info": "塔周危险提示"
        },
        "entry": {
          "flags_required": [
            "heard_tower_broadcast"
          ]
        },
        "exit": {
          "flags_any": [
            "ember_trusted",
            "ember_refused"
          ]
        },
        "fail": {
          "he_yashan_dead_early": "branch_ember_collapse"
        },
        "next_chapter_trigger": {
          "chapter_id": "ch_02_static",
          "flags_any": [
            "ember_trusted",
            "ember_refused"
          ]
        },
        "npc_ids": [
          "npc_story_he_yashan",
          "npc_story_mai_qin"
        ],
        "save_nodes": [
          "ember_met",
          "ember_done"
        ],
        "map_content_gap": [
          "ember_outpost_near POI marker"
        ]
      }
    },
    {
      "id": "ch_02_static",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter"
      ],
      "data": {
        "title": "噪声",
        "order": 2,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 48,
        "locations": [
          "signal_tower_perimeter"
        ],
        "background": "無論是否加入餘火，塔周都是唯一能验证广播是否「真人值守」的外围。",
        "why_enter": "需要录音/物证说服自己或据点：广播背后有人在调度。",
        "goal": "调查广播外围，收集录音与路径证据，获得 tower_perimeter_intel。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "潜入塔周警戒线，避开护卫与空壳潮"
          },
          {
            "step": 2,
            "desc": "取得维护日志残页或对讲加密碎片"
          },
          {
            "step": 3,
            "desc": "发现「救援箭嘴」与真实道路分叉"
          },
          {
            "step": 4,
            "desc": "带回情报；可选择是否告诉何崖山"
          }
        ],
        "major_events": [
          "发现假道分叉",
          "听到采样站内侧隐约发电机"
        ],
        "dialogues": [
          {
            "id": "dlg_st_log",
            "speaker": "文件",
            "lines": [
              "腳本庫：安撫－集合－分流。禁止提及採樣。",
              "配額上調。優先標記「低痛閾」個體。"
            ],
            "lines_en": [
              "Script library: calm — assemble — divert. Do not mention sampling.",
              "Quota raised. Prioritize individuals marked low pain threshold."
            ],
            "lines_zh_tw": [
              "腳本庫：安撫－集合－分流。禁止提及採樣。",
              "配額上調。優先標記「低痛閾」個體。"
            ],
            "emotion": "clinical",
            "speaker_name_en": "File",
            "speaker_name_zh_tw": "文件"
          },
          {
            "id": "dlg_st_he",
            "speaker": "npc_story_he_yashan",
            "condition": "ember_trusted",
            "lines": [
              "我說過。牆不是嚇你。",
              "你要是還想往裡走，先想清楚你帶回來的是火還是引線。"
            ],
            "lines_en": [
              "I told you. The wall isn't just there to scare you.",
              "If you're still walking deeper, decide whether you're bringing back fire — or a fuse."
            ],
            "lines_zh_tw": [
              "我說過。牆不是嚇你。",
              "你要是還想往裡走，先想清楚你帶回來的是火還是引線。"
            ],
            "emotion": "grave",
            "speaker_name_en": "He Yashan",
            "speaker_name_zh_tw": "何崖山"
          }
        ],
        "choices": [
          {
            "choice_id": "chc_st_share",
            "prompt": "是否与餘火共享塔周情报",
            "options": [
              {
                "id": "share",
                "effects": {
                  "flags": {
                    "tower_intel_shared": true,
                    "tower_perimeter_intel": true
                  }
                }
              },
              {
                "id": "keep",
                "effects": {
                  "flags": {
                    "tower_perimeter_intel": true,
                    "tower_intel_hoarded": true
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "stealth",
          "investigate",
          "audio_logs"
        ],
        "environment_narrative": [
          "生锈喇叭箱",
          "地面白色箭头被血覆盖又重画"
        ],
        "entry": {
          "flags_any": [
            "ember_trusted",
            "ember_refused"
          ]
        },
        "exit": {
          "flags_required": [
            "tower_perimeter_intel"
          ]
        },
        "next_chapter_trigger": {
          "chapter_id": "ch_03_ledger",
          "flags_required": [
            "tower_perimeter_intel"
          ]
        },
        "npc_ids": [
          "npc_story_he_yashan"
        ],
        "map_content_gap": [
          "signal_tower_perimeter"
        ]
      }
    },
    {
      "id": "ch_03_ledger",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter"
      ],
      "data": {
        "title": "名册",
        "order": 3,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 52,
        "locations": [
          "hospital_archive",
          "ember_outpost_near"
        ],
        "background": "塔周「低痛阈」字样与麦琴对小南的秘密观察重合。周晚晴也可能在档案层出现。",
        "why_enter": "追查钝感携带者线索；道德选择不可避免。",
        "goal": "作出 carrier_hidden / carrier_revealed / carrier_handed_over 之一。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "医院档案层取得澄海相关住院撕页"
          },
          {
            "step": 2,
            "desc": "与麦琴对质小南的发热史"
          },
          {
            "step": 3,
            "desc": "与周晚晴短暂重逢（若存活路径）"
          },
          {
            "step": 4,
            "desc": "选择：藏匿 / 据内公开 / 交给「救援渠道」"
          }
        ],
        "major_events": [
          "重逢周晚晴",
          "小南身份危机",
          "名单伦理摊牌"
        ],
        "dialogues": [
          {
            "id": "dlg_ld_zhou",
            "speaker": "npc_story_zhou_wanqing",
            "lines": [
              "沈渡。你還活著——好。",
              "車庫門禁……是我簽的遠端鎖。我以為能少死些搶物資的人。",
              "名單被人改過。有些名字後面多了採樣標記。我需要原件。"
            ],
            "lines_en": [
              "Shen Du. You're alive — good.",
              "The garage lock… I signed the remote seal. I thought fewer people would die fighting over supplies.",
              "The list was altered. Some names got sampling marks. I need the original."
            ],
            "lines_zh_tw": [
              "沈渡。你還活著——好。",
              "車庫門禁……是我簽的遠端鎖。我以為能少死些搶物資的人。",
              "名單被人改過。有些名字後面多了採樣標記。我需要原件。"
            ],
            "emotion": "guilt",
            "speaker_name_en": "Zhou Wanqing",
            "speaker_name_zh_tw": "周晚晴"
          },
          {
            "id": "dlg_ld_player_opts",
            "speaker": "npc_story_player",
            "lines": [
              "（選項A）你鎖門的時候，對講裡有人在叫我的名字。",
              "（選項B）先說名單。門的事……我們活著再說。",
              "（選項C）我來是找你，不是來聽解釋。"
            ],
            "lines_en": [
              "(Option A) When you locked that door, someone on the radio was calling my name.",
              "(Option B) The list first. The door… we talk about that if we're still alive.",
              "(Option C) I came looking for you — not for excuses."
            ],
            "lines_zh_tw": [
              "（選項A）你鎖門的時候，對講裡有人在叫我的名字。",
              "（選項B）先說名單。門的事……我們活著再說。",
              "（選項C）我來是找你，不是來聽解釋。"
            ],
            "emotion": "tense",
            "speaker_name_en": "Shen Du",
            "speaker_name_zh_tw": "沈渡"
          },
          {
            "id": "dlg_ld_mai_xiao",
            "speaker": "npc_story_mai_qin",
            "lines": [
              "小南發熱過，沒攻人。你要是把她送去喇叭，我就當沒救過你。"
            ],
            "lines_en": [
              "Xiao Nan had a fever. She never attacked. Send her to the loudspeakers and I'll pretend I never saved you."
            ],
            "lines_zh_tw": [
              "小南發熱過，沒攻人。你要是把她送去喇叭，我就當沒救過你。"
            ],
            "emotion": "protective",
            "speaker_name_en": "Mai Qin",
            "speaker_name_zh_tw": "麥琴"
          },
          {
            "id": "dlg_ld_xiao",
            "speaker": "npc_story_xiao_nan",
            "lines": [
