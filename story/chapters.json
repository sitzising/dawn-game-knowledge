    {
      "id": "ch_07_tide",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter"
      ],
      "data": {
        "title": "灰潮",
        "order": 7,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 65,
        "locations": [
          "ember_outpost_near",
          "dock_warehouse_band",
          "city_gate"
        ],
        "background": "真相扩散或封锁都会搅动人群。空壳潮被枪声与广播异常吸引，冲击据点。人物生死在此分岔。",
        "why_enter": "不可逆的中期危机；为终局积攒存活者与资源。",
        "goal": "存活并达成 tide_survived；关键 NPC 存活状态写入 story_progress。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "选择死守餘火 / 撤向码头 / 分散逃"
          },
          {
            "step": 2,
            "desc": "保卫或撤离中的人物救助检定"
          },
          {
            "step": 3,
            "desc": "广播可能被司衡方加强干扰"
          },
          {
            "step": 4,
            "desc": "潮后清点：谁还活着"
          }
        ],
        "dialogues": [
          {
            "id": "dlg_td_he",
            "speaker": "npc_story_he_yashan",
            "lines": [
              "灶火可以滅，人不能滅完。",
              "你帶誰走，就等於宣判誰留下。別裝看不見。"
            ],
            "lines_en": [
              "You can kill a cookfire. You don't get to erase every person with it.",
              "Who you take with you is a sentence on who you leave. Don't pretend you don't see that."
            ],
            "lines_zh_tw": [
              "灶火可以滅，人不能滅完。",
              "你帶誰走，就等於宣判誰留下。別裝看不見。"
            ],
            "emotion": "weary",
            "speaker_name_en": "He Yashan",
            "speaker_name_zh_tw": "何崖山"
