{
  "domain": "story",
  "version": 2,
  "entries": [
    {
      "id": "ch_prologue",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter",
        "playable_first"
      ],
      "data": {
        "title": "灰门之前",
        "order": 0,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 45,
        "locations": [
          "garage_safezone",
          "city_gate"
        ],
        "background": "灾难第四十五天。沈渡在城郊市政车库耗尽罐头，决定沿旧补给线向城门方向移动。对讲机里只剩底噪与偶尔掠过的信号塔广播碎片。",
        "why_enter": "补给耗尽；寻找周晚晴与任何活人组织。",
        "goal": "离开车库补给线，抵达城门方向并确认听到信号塔广播。",
        "quest_flow": [
          {
            "step": 1,
            "id": "pr_loot",
            "desc": "在车库与毗邻工具间搜刮医疗与电池"
          },
          {
            "step": 2,
            "id": "pr_radio",
            "desc": "修复或拾取手持收信机，锁定短波频道"
          },
          {
            "step": 3,
            "id": "pr_road",
            "desc": "沿补给线潜行/战斗通过稀疏空壳"
          },
          {
            "step": 4,
            "id": "pr_gate",
            "desc": "抵达城门接近点，完整收听一轮广播"
          }
        ],
        "major_events": [
          "发现同事工牌与未送出的对讲录音",
          "第一次近距离面对行尸趋声",
          "广播完整句：科学救援、离港集合、带上健康证明"
        ],
        "dialogues": [
          {
            "id": "dlg_pr_radio_log",
            "speaker": "录音/同事",
            "lines": [
              "調度，車庫側門還是鎖的——外面在撞門。",
              "沈渡？你要是聽得到……別按表單了。開門。",
              "……訊號沒了。"
            ],
            "lines_en": [
              "Dispatch — the garage side door is still locked. Something's slamming it from outside.",
              "Shen Du? If you can hear this… stop following the damn checklist. Open the door.",
              "…Signal's gone."
            ],
            "lines_zh_tw": [
              "調度，車庫側門還是鎖的——外面在撞門。",
              "沈渡？你要是聽得到……別按表單了。開門。",
              "……訊號沒了。"
            ],
            "emotion": "urgent",
            "speaker_name_en": "Radio / Colleague",
            "speaker_name_zh_tw": "錄音／同事"
          },
          {
            "id": "dlg_pr_broadcast",
            "speaker": "信号塔",
            "lines": [
              "這裡是澄海應急科學救援協調頻道。",
              "健康成年倖存者請前往指示集合點，準備有序離港。",
              "請攜帶身分證明。重複。"
            ],
            "lines_en": [
              "This is the Chenghai Emergency Science Rescue Coordination Channel.",
              "Healthy adult survivors, proceed to the marked assembly points and prepare for orderly evacuation.",
              "Bring identification. I repeat: bring identification."
            ],
            "lines_zh_tw": [
              "這裡是澄海應急科學救援協調頻道。",
              "健康成年倖存者請前往指示集合點，準備有序離港。",
              "請攜帶身分證明。重複。"
            ],
            "emotion": "official",
            "speaker_name_en": "Signal Tower",
            "speaker_name_zh_tw": "訊號塔"
          },
          {
            "id": "dlg_pr_he_spot",
            "speaker": "npc_story_he_yashan",
            "condition": "optional_spot",
            "lines": [
              "別往喇叭走。去的人，牆上有名。",
              "你要找活人，跟灰煙走——別跟廣播走。"
            ],
            "lines_en": [
              "Don't follow the loudspeaker. The names of people who did are already on the wall.",
              "If you want the living, follow the gray smoke — not the broadcast."
            ],
            "lines_zh_tw": [
              "別往喇叭走。去的人，牆上有名。",
              "你要找活人，跟灰煙走——別跟廣播走。"
            ],
            "emotion": "warning",
            "speaker_name_en": "He Yashan",
            "speaker_name_zh_tw": "何崖山"
          }
        ],
        "choices": [
          {
            "choice_id": "chc_pr_listen_full",
            "prompt": "是否完整录下广播",
            "options": [
              {
                "id": "record",
                "effects": {
                  "flags": {
                    "heard_tower_broadcast": true,
                    "broadcast_recorded": true
                  }
                }
              },
              {
                "id": "ignore_detail",
                "effects": {
                  "flags": {
                    "heard_tower_broadcast": true
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "survival_intro",
          "loot",
          "zombie_pressure",
          "radio_discover"
        ],
        "environment_narrative": [
          "卷帘门内侧指甲抓痕",
          "调度系统锁屏仍显示「远程锁止：防物资流失」",
          "城门告示被新纸覆盖：「救援此路」箭头指向采样假道"
        ],
        "rewards": {
          "items_hint": [
            "medkit_small",
            "battery_pack"
          ],
          "flags": [
            "heard_tower_broadcast"
          ]
        },
        "exit": {
          "flags_any": [
            "heard_tower_broadcast",
            "reached_city_gate_approach"
          ]
        },
        "entry": {
          "flags_required": [],
          "chapter_complete": []
        },
        "fail": {
          "player_dead": true
        },
        "next_chapter_trigger": {
          "chapter_id": "ch_01_ember",
          "flags_required": [
            "heard_tower_broadcast"
          ]
        },
        "npc_ids": [
          "npc_story_he_yashan"
        ],
        "save_nodes": [
          "prologue_start",
          "prologue_gate"
        ],
        "missable": [
          "garage_extra_medkit"
        ],
        "map_content_gap": []
      }
