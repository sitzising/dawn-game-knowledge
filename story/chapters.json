{
  "domain": "story",
  "version": 2,
  "entries": [
    {
      "id": "ch_prologue",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter",
        "playable_first"
      ],
      "data": {
        "title": "灰门之前",
        "order": 0,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 45,
        "locations": [
          "garage_safezone",
          "city_gate"
        ],
        "background": "灾难第四十五天。沈渡在城郊市政车库耗尽罐头，决定沿旧补给线向城门方向移动。对讲机里只剩底噪与偶尔掠过的信号塔广播碎片。",
        "why_enter": "补给耗尽；寻找周晚晴与任何活人组织。",
        "goal": "离开车库补给线，抵达城门方向并确认听到信号塔广播。",
        "quest_flow": [
          {
            "step": 1,
            "id": "pr_loot",
            "desc": "在车库与毗邻工具间搜刮医疗与电池"
          },
          {
            "step": 2,
            "id": "pr_radio",
            "desc": "修复或拾取手持收信机，锁定短波频道"
          },
          {
            "step": 3,
            "id": "pr_road",
            "desc": "沿补给线潜行/战斗通过稀疏空壳"
          },
          {
            "step": 4,
            "id": "pr_gate",
            "desc": "抵达城门接近点，完整收听一轮广播"
          }
        ],
        "major_events": [
          "发现同事工牌与未送出的对讲录音",
          "第一次近距离面对行尸趋声",
          "广播完整句：科学救援、离港集合、带上健康证明"
        ],
        "dialogues": [
          {
            "id": "dlg_pr_radio_log",
            "speaker": "录音/同事",
            "lines": [
              "调度，车库侧门还是锁的——外面在撞门。",
              "沈渡？你要是听得到……别按表单了。开门。",
              "……信号没了。"
            ]
          },
          {
            "id": "dlg_pr_broadcast",
            "speaker": "信号塔",
            "lines": [
              "这里是澄海应急科学救援协调频道。",
              "健康成年幸存者请前往指示集合点，准备有序离港。",
              "请携带身份证明。重复。"
            ]
          },
          {
            "id": "dlg_pr_he_spot",
            "speaker": "npc_story_he_yashan",
            "condition": "optional_spot",
            "lines": [
              "别往喇叭走。去的人，墙上有名。",
              "你要找活人，跟灰烟走——别跟广播走。"
            ]
          }
        ],
        "choices": [
          {
            "choice_id": "chc_pr_listen_full",
            "prompt": "是否完整录下广播",
            "options": [
              {
                "id": "record",
                "effects": {
                  "flags": {
                    "heard_tower_broadcast": true,
                    "broadcast_recorded": true
                  }
                }
              },
              {
                "id": "ignore_detail",
                "effects": {
                  "flags": {
                    "heard_tower_broadcast": true
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "survival_intro",
          "loot",
          "zombie_pressure",
          "radio_discover"
        ],
        "environment_narrative": [
          "卷帘门内侧指甲抓痕",
          "调度系统锁屏仍显示「远程锁止：防物资流失」",
          "城门告示被新纸覆盖：「救援此路」箭头指向采样假道"
        ],
        "rewards": {
          "items_hint": [
            "medkit_small",
            "battery_pack"
          ],
          "flags": [
            "heard_tower_broadcast"
          ]
        },
        "exit": {
          "flags_any": [
            "heard_tower_broadcast",
            "reached_city_gate_approach"
          ]
        },
        "entry": {
          "flags_required": [],
          "chapter_complete": []
        },
        "fail": {
          "player_dead": true
        },
        "next_chapter_trigger": {
          "chapter_id": "ch_01_ember",
          "flags_required": [
            "heard_tower_broadcast"
          ]
        },
        "npc_ids": [
          "npc_story_he_yashan"
        ],
        "save_nodes": [
          "prologue_start",
          "prologue_gate"
        ],
        "missable": [
          "garage_extra_medkit"
        ],
        "map_content_gap": []
      }
    },
    {
      "id": "ch_01_ember",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter",
        "playable_first"
      ],
      "data": {
        "title": "餘火",
        "order": 1,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 46,
        "locations": [
          "ember_outpost_near"
        ],
        "background": "广播让沈渡成为「可能的信徒」。何崖山需要劳动力，也需要证明外来者不会把据点坐标卖给喇叭。",
        "why_enter": "城门方向接触到餘火哨或被引导至旧中学。",
        "goal": "接触何崖山，取得餘火盟信任或明确拒绝其庇护，完成一次物资或护送。",
        "quest_flow": [
          {
            "step": 1,
            "id": "em_meet",
            "desc": "在据点外围通过搜身与问答"
          },
          {
            "step": 2,
            "id": "em_trial",
            "desc": "选择：护送伤员 / 取回被劫药箱"
          },
          {
            "step": 3,
            "id": "em_judge",
            "desc": "何崖山宣布信任或拒绝庇护"
          },
          {
            "step": 4,
            "id": "em_mai",
            "desc": "麦琴提供感染观察常识（可选）"
          }
        ],
        "major_events": [
          "初见餘火灶火",
          "「去者未归」墙",
          "信任检定"
        ],
        "dialogues": [
          {
            "id": "dlg_em_he_intro",
            "speaker": "npc_story_he_yashan",
            "lines": [
              "工牌还挂着。市政的人，锁过多少门？",
              "这里规矩简单：先干活，再吃饭。广播的饭，我们不吃。",
              "你要留下，去把巷口那箱药带回来——或者把老陈护到白篷点。选一个。"
            ]
          },
          {
            "id": "dlg_em_mai",
            "speaker": "npc_story_mai_qin",
            "lines": [
              "发热不等于空壳。别一枪崩了还能说话的人。",
              "深咬、清创、隔离。听不懂就别碰伤员。"
            ]
          },
          {
            "id": "dlg_em_trust",
            "speaker": "npc_story_he_yashan",
            "condition": "trial_success",
            "lines": [
              "你没把我们卖给喇叭。暂且算人。",
              "墙那边的名字，别变成你的。"
            ]
          }
        ],
        "choices": [
          {
            "choice_id": "chc_em_trial",
            "prompt": "信任试炼类型",
            "options": [
              {
                "id": "escort",
                "effects": {
                  "flags": {
                    "ember_trial_escort": true
                  }
                }
              },
              {
                "id": "supply",
                "effects": {
                  "flags": {
                    "ember_trial_supply": true
                  }
                }
              }
            ]
          },
          {
            "choice_id": "chc_em_join",
            "prompt": "是否接受餘火庇护",
            "options": [
              {
                "id": "accept",
                "effects": {
                  "flags": {
                    "ember_trusted": true
                  },
                  "faction": {
                    "faction_ember": 20
                  }
                }
              },
              {
                "id": "refuse",
                "effects": {
                  "flags": {
                    "ember_refused": true
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "meet_ally",
          "escort_or_supply",
          "trust_check"
        ],
        "environment_narrative": [
          "食堂黑板上的工分",
          "去者未归名单用炭笔写"
        ],
        "rewards": {
          "reputation_ember": "up_if_trusted",
          "info": "塔周危险提示"
        },
        "entry": {
          "flags_required": [
            "heard_tower_broadcast"
          ]
        },
        "exit": {
          "flags_any": [
            "ember_trusted",
            "ember_refused"
          ]
        },
        "fail": {
          "he_yashan_dead_early": "branch_ember_collapse"
        },
        "next_chapter_trigger": {
          "chapter_id": "ch_02_static",
          "flags_any": [
            "ember_trusted",
            "ember_refused"
          ]
        },
        "npc_ids": [
          "npc_story_he_yashan",
          "npc_story_mai_qin"
        ],
        "save_nodes": [
          "ember_met",
          "ember_done"
        ],
        "map_content_gap": [
          "ember_outpost_near POI marker"
        ]
      }
    },
    {
      "id": "ch_02_static",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter"
      ],
      "data": {
        "title": "噪声",
        "order": 2,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 48,
        "locations": [
          "signal_tower_perimeter"
        ],
        "background": "無論是否加入餘火，塔周都是唯一能验证广播是否「真人值守」的外围。",
        "why_enter": "需要录音/物证说服自己或据点：广播背后有人在调度。",
        "goal": "调查广播外围，收集录音与路径证据，获得 tower_perimeter_intel。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "潜入塔周警戒线，避开护卫与空壳潮"
          },
          {
            "step": 2,
            "desc": "取得维护日志残页或对讲加密碎片"
          },
          {
            "step": 3,
            "desc": "发现「救援箭嘴」与真实道路分叉"
          },
          {
            "step": 4,
            "desc": "带回情报；可选择是否告诉何崖山"
          }
        ],
        "major_events": [
          "发现假道分叉",
          "听到采样站内侧隐约发电机"
        ],
        "dialogues": [
          {
            "id": "dlg_st_log",
            "speaker": "文件",
            "lines": [
              "脚本库：安抚-集合-分流。禁止提及采样。",
              "配额上调。优先标记「低痛阈」个体。"
            ]
          },
          {
            "id": "dlg_st_he",
            "speaker": "npc_story_he_yashan",
            "condition": "ember_trusted",
            "lines": [
              "我说过。墙不是吓你。",
              "你要是还想往里走，先想清楚你带回来的是火还是引线。"
            ]
          }
        ],
        "choices": [
          {
            "choice_id": "chc_st_share",
            "prompt": "是否与餘火共享塔周情报",
            "options": [
              {
                "id": "share",
                "effects": {
                  "flags": {
                    "tower_intel_shared": true,
                    "tower_perimeter_intel": true
                  }
                }
              },
              {
                "id": "keep",
                "effects": {
                  "flags": {
                    "tower_perimeter_intel": true,
                    "tower_intel_hoarded": true
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "stealth",
          "investigate",
          "audio_logs"
        ],
        "environment_narrative": [
          "生锈喇叭箱",
          "地面白色箭头被血覆盖又重画"
        ],
        "entry": {
          "flags_any": [
            "ember_trusted",
            "ember_refused"
          ]
        },
        "exit": {
          "flags_required": [
            "tower_perimeter_intel"
          ]
        },
        "next_chapter_trigger": {
          "chapter_id": "ch_03_ledger",
          "flags_required": [
            "tower_perimeter_intel"
          ]
        },
        "npc_ids": [
          "npc_story_he_yashan"
        ],
        "map_content_gap": [
          "signal_tower_perimeter"
        ]
      }
    },
    {
      "id": "ch_03_ledger",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter"
      ],
      "data": {
        "title": "名册",
        "order": 3,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 52,
        "locations": [
          "hospital_archive",
          "ember_outpost_near"
        ],
        "background": "塔周「低痛阈」字样与麦琴对小南的秘密观察重合。周晚晴也可能在档案层出现。",
        "why_enter": "追查钝感携带者线索；道德选择不可避免。",
        "goal": "作出 carrier_hidden / carrier_revealed / carrier_handed_over 之一。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "医院档案层取得澄海相关住院撕页"
          },
          {
            "step": 2,
            "desc": "与麦琴对质小南的发热史"
          },
          {
            "step": 3,
            "desc": "与周晚晴短暂重逢（若存活路径）"
          },
          {
            "step": 4,
            "desc": "选择：藏匿 / 据内公开 / 交给「救援渠道」"
          }
        ],
        "major_events": [
          "重逢周晚晴",
          "小南身份危机",
          "名单伦理摊牌"
        ],
        "dialogues": [
          {
            "id": "dlg_ld_zhou",
            "speaker": "npc_story_zhou_wanqing",
            "lines": [
              "沈渡。你还活着——好。",
              "车库门禁……是我签的远程锁。我以为能少死些抢物资的人。",
              "名单被人改过。有些名字后面多了采样标记。我需要原件。"
            ]
          },
          {
            "id": "dlg_ld_player_opts",
            "speaker": "npc_story_player",
            "lines": [
              "（选项A）你锁门的时候，对讲里有人在叫我的名字。",
              "（选项B）先说名单。门的事……我们活着再说。",
              "（选项C）我来是找你，不是来听解释。"
            ]
          },
          {
            "id": "dlg_ld_mai_xiao",
            "speaker": "npc_story_mai_qin",
            "lines": [
              "小南发热过，没攻人。你要是把她送去喇叭，我就当没救过你。"
            ]
          },
          {
            "id": "dlg_ld_xiao",
            "speaker": "npc_story_xiao_nan",
            "lines": [
              "别用看标本的眼神看我。",
              "我可以跑。你们别为了我打架。"
            ]
          }
        ],
        "choices": [
          {
            "choice_id": "chc_ld_zhou_blame",
            "prompt": "如何回应周晚晴锁门",
            "options": [
              {
                "id": "confront",
                "effects": {
                  "flags": {
                    "zhou_confronted": true
                  },
                  "rel": {
                    "npc_story_zhou_wanqing": -10
                  }
                }
              },
              {
                "id": "defer",
                "effects": {
                  "flags": {
                    "zhou_deferred": true
                  },
                  "rel": {
                    "npc_story_zhou_wanqing": 5
                  }
                }
              },
              {
                "id": "cold",
                "effects": {
                  "flags": {
                    "zhou_cold": true
                  },
                  "rel": {
                    "npc_story_zhou_wanqing": -5
                  }
                }
              }
            ]
          },
          {
            "choice_id": "chc_ld_carrier",
            "prompt": "小南处置",
            "options": [
              {
                "id": "hide",
                "effects": {
                  "flags": {
                    "carrier_hidden": true
                  },
                  "rel": {
                    "npc_story_mai_qin": 15,
                    "npc_story_he_yashan": 5
                  }
                }
              },
              {
                "id": "reveal",
                "effects": {
                  "flags": {
                    "carrier_revealed": true
                  },
                  "rel": {
                    "npc_story_he_yashan": -5
                  }
                }
              },
              {
                "id": "hand_over",
                "effects": {
                  "flags": {
                    "carrier_handed_over": true
                  },
                  "rel": {
                    "npc_story_mai_qin": -40,
                    "npc_story_he_yashan": -20
                  },
                  "npc_alive": {
                    "npc_story_xiao_nan": false
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "investigate",
          "moral_choice",
          "medical"
        ],
        "environment_narrative": [
          "冷柜贴澄海标识",
          "住院记录「痛阈异常」被红笔圈"
        ],
        "entry": {
          "flags_required": [
            "tower_perimeter_intel"
          ]
        },
        "exit": {
          "flags_any": [
            "carrier_hidden",
            "carrier_revealed",
            "carrier_handed_over"
          ]
        },
        "next_chapter_trigger": {
          "chapter_id": "ch_04_cutroad",
          "flags_any": [
            "carrier_hidden",
            "carrier_revealed",
            "carrier_handed_over"
          ]
        },
        "npc_ids": [
          "npc_story_mai_qin",
          "npc_story_zhou_wanqing",
          "npc_story_xiao_nan"
        ],
        "map_content_gap": [
          "hospital_archive"
        ]
      }
    },
    {
      "id": "ch_04_cutroad",
      "domain": "story",
      "version": 2,
      "tags": [
        "chapter"
      ],
      "data": {
        "title": "断路",
        "order": 4,
        "map_id": "hongkong_city",
        "content_status": "authored_pending_poi",
        "era_day": 55,
        "locations": [
          "cutroad_yard"
        ],
        "background": "无论名单如何处置，东环是通往码头与实验室的咽喉。根想做生意，铁眼想收血税。",
        "why_enter": "护送/载具线必须过卡，或绕行风险更高。",
        "goal": "达成 cutroad_dealt / cutroad_fought / cutroad_fled 之一，保护关键物资或人物通过。",
        "quest_flow": [
          {
            "step": 1,
            "desc": "接触根谈判"
          },
          {
            "step": 2,
            "desc": "可选揭发根卖人（若已有线索）"
          },
          {
            "step": 3,
            "desc": "交易零件/弹药，或强攻，或弃货逃离"
          },
          {
            "step": 4,
            "desc": "铁眼可能介入"
          }
        ],
        "dialogues": [
          {
            "id": "dlg_cr_root",
            "speaker": "npc_story_root",
            "lines": [
              "过路费不收笑脸。收电池、收子弹，收你还用得上的东西。",
              "你要找船？那是喇叭的生意。我只卖路。"
            ]
          },
          {
            "id": "dlg_cr_tieyan",
            "speaker": "npc_story_tieyan",
            "condition": "fight_or_betray",
            "lines": [
              "货留下。人可以走。",
              "不走？"
            ]
          }
        ],
        "choices": [
          {
            "choice_id": "chc_cr_approach",
            "prompt": "过卡方式",
            "options": [
              {
                "id": "deal",
                "effects": {
                  "flags": {
                    "cutroad_dealt": true
                  },
                  "resources": {
                    "ammo_or_parts": "pay"
                  }
                }
              },
              {
                "id": "fight",
                "effects": {
                  "flags": {
                    "cutroad_fought": true
                  },
                  "npc_alive_risk": [
                    "npc_story_root",
                    "npc_story_tieyan"
                  ]
                }
              },
              {
                "id": "flee",
                "effects": {
                  "flags": {
                    "cutroad_fled": true
                  },
                  "resources": {
                    "cargo_lost": true
                  }
                }
              }
            ]
          },
          {
            "choice_id": "chc_cr_expose_root",
            "prompt": "是否当众揭发根卖坐标",
            "options": [
              {
                "id": "expose",
                "effects": {
                  "flags": {
                    "root_exposed": true
                  },
                  "may_trigger": "tieyan_kill_root"
                }
              },
              {
                "id": "silent",
                "effects": {
                  "flags": {
                    "root_silence": true
                  }
                }
              }
            ]
          }
        ],
        "gameplay": [
          "vehicle",
          "combat_or_deal",
          "transport"
        ],
        "entry": {
          "flags_any": [
            "carrier_hidden",
            "carrier_revealed",
            "carrier_handed_over"
          ]
        },
        "exit": {
          "flags_any": [
            "cutroad_dealt",
