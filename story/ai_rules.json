{
  "domain": "story",
  "version": 2,
  "entries": [
    {
      "id": "story.ai_dialogue_rules",
      "domain": "story",
      "version": 2,
      "tags": [
        "ai",
        "rules"
      ],
      "data": {
        "may": [
          "free_chat_in_character",
          "react_to_player_history",
          "react_to_memory",
          "discuss_known_world_facts",
          "suggest_actions_aligned_with_npc_goals",
          "use_personal_voice_style"
        ],
        "must_not": [
          "invent_main_plot_facts",
          "invent_quests",
          "change_quest_state",
          "change_story_flags",
          "spawn_items",
          "modify_player_inventory",
          "resurrect_characters",
          "change_factions_unilaterally",
          "reveal_future_chapters",
          "reveal_secrets_above_tier",
          "speak_as_dead_npc",
          "claim_witness_to_unwitnessed_events",
          "claim_incomplete_quest_complete",
          "alter_ending_conditions"
        ],
        "deterministic_owns": [
          "chapter_gated_dialogues",
          "quest_state_transitions",
          "flag_writes",
          "ending_resolution"
        ],
        "ai_owns": [
          "color_dialogue",
          "rumor_labeled_hearsay",
          "emotional_reaction"
        ],
        "fact_vs_rumor": "NPC must label hearsay as rumor, never as certainty.",
        "context_pipeline": [
          "location",
          "chapter",
          "quest",
          "npc_profile",
          "npc_memory",
          "relationship",
          "allowed_story_entries",
          "generate"
        ]
      }
    },
    {
      "id": "story.ai_knowledge_tiers",
      "domain": "story",
      "version": 2,
      "tags": [
        "ai",
        "filter"
      ],
      "data": {
        "tiers_order": [
          "street",
          "district",
          "faction",
          "military",
          "lab",
          "core"
        ],
        "default_player_tier": "street",
        "filter_rule": "NPC may only receive story entries whose knowledge_tier index <= NPC knowledge_tier index, plus explicit knows[] ids.",
        "may_know": [
          "lived_events",
          "told_info",
          "public_info",
          "currently_observable"
        ],
        "must_not_know": [
          "future_events",
          "unpublished_secrets",
          "other_npc_private_memories",
          "player_undiscovered_intel"
        ]
      }
    },
