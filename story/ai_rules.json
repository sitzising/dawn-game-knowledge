      "domain": "story",
      "version": 2,
      "tags": [
        "voice"
      ],
      "data": {
        "max_spoken_chars": 180,
        "prefer_short_lines": true,
        "subtitle_required": true,
        "cache_key": "npc_id+line_hash+lang",
