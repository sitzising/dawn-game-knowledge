      "data": {
        "title": "衛士城現況",
        "summary": "濱海巨城衛士城在曦蝕爆發後封鎖。電力與通信崩潰，倖存者結成餘火盟，掠奪者盤據斷路，市政殘部退守碼頭倉庫。短波廣播承諾「科學救援離港」。",
        "map_id": "hongkong_city",
        "fiction_place_name": "衛士城",
        "fiction_region": "澄海沿岸都會帶",
        "era_day_start": 45,
        "population_pre": "约八百二十万（公开统计）",
        "population_estimate_day45": "城内活动幸存者估计不足四万；空壳与腐行者无法精确计数",
        "power_status": "分区跳闸后仅码头发电机与少数屋顶光伏残存",
        "comms_status": "民用蜂窝全灭；短波/对讲为主要联络；信号塔单向广播仍强",
        "knowledge_tier": "street"
      }
    },
